# AI Subtitle Translator Configuration by LavX
# https://github.com/LavX/ai-subtitle-translator

# OpenRouter Configuration
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_MAX_TOKENS=8000

# Back ends, tried in this order when one is rate limited, out of quota or unreachable
BACKEND_ORDER=openrouter,gemini
OPENROUTER_DENY_DATA_COLLECTION=false

# Google Gemini (optional): comma-separated keys; keys from one Google Cloud project share
# its limits, so name each key's project in the same order if you have several
GEMINI_API_KEYS=
GEMINI_KEY_PROJECTS=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BATCH_SIZE=300
GEMINI_REASONING=disabled
# USD per million input and output tokens; 0 reports usage with no cost and holds nothing
GEMINI_PRICE_INPUT=0
GEMINI_PRICE_OUTPUT=0

# An OpenAI-compatible server (optional): the OpenAI API, LM Studio, Ollama or any other.
# Add openai_compatible to BACKEND_ORDER to use it; put a local server first to try it first.
# OPENAI_COMPATIBLE_PRESET=lmstudio          # openai, lmstudio, ollama or custom
# OPENAI_COMPATIBLE_BASE_URL=http://192.168.1.10:1234/v1
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_API_KEY=                 # only if the server asks for one
# OPENAI_COMPATIBLE_PRICE_INPUT=0            # USD per million input tokens; required for the OpenAI preset
# OPENAI_COMPATIBLE_PRICE_OUTPUT=0

# Server Configuration
HOST=0.0.0.0
PORT=8765

# Translation Configuration
BATCH_SIZE=100
MAX_RETRIES=3
RETRY_DELAY=1.0
REQUEST_TIMEOUT=120.0

# Job Queue Configuration
JOB_QUEUE_MAX_CONCURRENT=10   # Max concurrent translation jobs
JOB_QUEUE_MAX_JOBS=100       # Max jobs in memory
JOB_QUEUE_TTL_HOURS=1        # Time-to-live for completed/failed jobs

# App identification for OpenRouter analytics
APP_NAME=ai-subtitle-translator
APP_URL=https://lavx.hu